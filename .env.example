PORT=3000
APP_HOST=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SCOPE=https://www.googleapis.com/auth/chat.bot
SPACE_ID=

REDIS_HOST=localhost
REDIS_PORT=6379

# Database
DATABASE_URL=postgresql://markbot_user:markbot_password@localhost:5432/markbot_vector?schema=markbot

# Chat Configuration
CHAT_PROVIDER=openai
CHAT_MODEL_NAME=gpt-4o
CHAT_TEMPERATURE=0.7
CHAT_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DATA_MARKEDOWN_PATH=./data/markdown

# Vector Processing Configuration
VECTOR_QUERY_LIMIT=6
VECTOR_MAX_CHUNK_SIZE=1000
VECTOR_CHUNK_OVERLAP=100
VECTOR_MODEL_NAME=Xenova/all-MiniLM-L6-v2
VECTOR_BATCH_SIZE=10

{
    "name": "markbot",
    "version": "1.0.0",
    "description": "Bot para interactuar con proyecto Markdown",
    "main": "dist/app/index.js",
    "scripts": {
        "start": "PORT=3002 NODE_OPTIONS='--no-deprecation' node dist/app/index.js & npm start --prefix web",
        "server": "PORT=3002 NODE_OPTIONS='--no-deprecation' nodemon --watch src -r tsconfig-paths/register src/app/index.ts",
        "client": "npm run dev --prefix web",
        "dev": "concurrently --hide 1,2 --prefix none --kill-others --handle-input \"npm run server\" \"npm run client\" \"lt --port 3002 --subdomain markbot\"",
        "build": "tsc && tsc-alias && mkdir -p dist/infrastructure/db/scripts && cp -r src/infrastructure/db/scripts/sql dist/infrastructure/db/scripts/ && cp -r public dist/ && npm run build --prefix web",
        "test": "jest",
        "lint": "eslint \"src/**/*.ts\"",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@langchain/community": "^1.1.9",
        "@langchain/core": "^1.1.17",
        "@langchain/ollama": "^1.2.2",
        "@langchain/openai": "^1.2.3",
        "@otplib/preset-default": "^12.0.1",
        "@types/jsonwebtoken": "^9.0.10",
        "argon2": "^0.44.0",
        "bullmq": "^5.67.1",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "google-auth-library": "^9.7.0",
        "ioredis": "^5.9.2",
        "jsonwebtoken": "^9.0.3",
        "kysely": "^0.27.2",
        "langchain": "^1.2.16",
        "morgan": "^1.10.1",
        "multer": "^2.0.2",
        "nodemailer": "^8.0.1",
        "otplib": "^13.3.0",
        "pg": "^8.11.3",
        "qrcode": "^1.5.4",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^20.11.30",
        "@types/nodemailer": "^7.0.10",
        "@types/pg": "^8.11.0",
        "@types/qrcode": "^1.5.6",
        "@types/supertest": "^6.0.3",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.1.0",
        "jest": "^30.2.0",
        "localtunnel": "^2.0.2",
        "nodemon": "^3.1.0",
        "prettier": "^3.8.1",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.4.3"
    },
    "overrides": {
        "axios": "^1.7.4"
    }
}

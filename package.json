{
    "name": "markbot",
    "version": "1.0.0",
    "description": "Bot para interactuar con proyecto Markdown",
    "main": "dist/index.js",
    "scripts": {
        "start": "PORT=3001 node dist/index.js & npm start --prefix web",
        "server": "PORT=3001 nodemon --watch src src/index.ts",
        "client": "npm run dev --prefix web",
        "dev": "concurrently \"npm run server\" \"npm run client\" \"lt --port 3000 --subdomain markbot\"",
        "build": "tsc && npm run build --prefix web",
        "test": "jest"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "google-auth-library": "^9.7.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.11.30",
        "@types/supertest": "^6.0.3",
        "concurrently": "^9.2.1",
        "jest": "^30.2.0",
        "localtunnel": "^2.0.2",
        "nodemon": "^3.1.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.3"
    }
}